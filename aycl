-- iOS-style switch at the right side of its parent row.
-- Returns a function that sets the switch from code without firing onChange.
local function createSwitch(parent, initial, onChange)
    local state = initial
    local onPos = UDim2.new(1, -20, 0.5, -9)
    local offPos = UDim2.new(0, 2, 0.5, -9)
    local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    local track = make("TextButton", {
        Position = UDim2.new(1, -52, 0.5, -11),
        Size = UDim2.new(0, 40, 0, 22),
        BackgroundColor3 = initial and THEME.Accent or THEME.SwitchOff,
        AutoButtonColor = false,
        Text = "",
        BorderSizePixel = 0,
    }, parent)
    corner(track, UDim.new(1, 0))

    local knob = make("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = initial and onPos or offPos,
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    corner(knob, UDim.new(1, 0))

    local function render()
        TweenService:Create(track, info, {
            BackgroundColor3 = state and THEME.Accent or THEME.SwitchOff,
        }):Play()
        TweenService:Create(knob, info, {
            Position = state and onPos or offPos,
        }):Play()
    end

    track.MouseButton1Click:Connect(function()
        state = not state
        render()
        onChange(state)
    end)

    return function(newState)
        if newState ~= state then
            state = newState
            render()
        end
    end
end

