-- Stops the script completely: removes effects, added items, emote, camera, keybinds and GUI
local function closeScript()
    if closed then return end
    closed = true

    removeKorblox()
    removeHeadless()
    removeAllAdded() -- also restores any original clothing that was blanked
    stopEmote()
    camLockSwitchSet = nil
    disableCamLock()

    rebindingId = nil
    refreshKeyHints = nil
    keybindStatusSet = nil

    for _, b in ipairs(originalBackups) do
        pcall(function() b:Destroy() end)
    end
    table.clear(originalBackups)

    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)

    if gui then
        gui:Destroy()
        gui = nil
    end
    mainFrame = nil
    listFrame = nil

    env.LocalCosmeticsCleanup = nil
end

