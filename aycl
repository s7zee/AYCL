-- Finds the model that is actually drawn on screen.
-- Evade keeps a full rig in Workspace.Rigs[PlayerName]; player.Character is an invisible stub.
-- In other games there is no Rigs folder, so it falls back to the normal character.
local function getVisualChar()
    local rigs = workspace:FindFirstChild("Rigs")
    return (rigs and rigs:FindFirstChild(player.Name)) or player.Character
end

-- Korblox

local function applyKorbloxR15(char)
    local upper = char:WaitForChild("RightUpperLeg", 5)
    local lower = char:WaitForChild("RightLowerLeg", 5)
    local foot = char:WaitForChild("RightFoot", 5)
    if not (upper and lower and foot) then
        warn("[LocalCosmetics] R15 leg parts missing in " .. char:GetFullName())
        return nil
    end

    local old = {
        upper = upper.Transparency,
        lower = lower.Transparency,
        foot = foot.Transparency,
    }

    local fullHeight = upper.Size.Y + lower.Size.Y + foot.Size.Y
    local leg
    local alignHeight

    -- Preferred: MeshPart with the mesh's real native size (no stretching)
    local ok, meshPart = pcall(function()
        return InsertService:CreateMeshPartAsync(
            KORBLOX_MESH,
            Enum.CollisionFidelity.Box,
            Enum.RenderFidelity.Automatic
        )
    end)

    if ok and meshPart then
        leg = meshPart
        leg.TextureID = KORBLOX_TEXTURE
        alignHeight = leg.Size.Y
    else
        -- Fallback: SpecialMesh at scale 1 renders at native size, never stretched
        leg = Instance.new("Part")
        leg.Size = Vector3.new(1, 1, 1)
        local sm = Instance.new("SpecialMesh")
        sm.MeshType = Enum.MeshType.FileMesh
        sm.MeshId = KORBLOX_MESH
        sm.TextureId = KORBLOX_TEXTURE
        sm.Scale = Vector3.new(1, 1, 1)
        sm.Parent = leg
        alignHeight = fullHeight
    end

    leg.Name = "KorbloxLeg"
    leg.Anchored = false
    leg.CanCollide = false
    leg.CanTouch = false
    leg.CanQuery = false
    leg.Massless = true
    leg.Parent = char

    -- Line the top of the mesh up with the top of the thigh
    local y = (upper.Size.Y / 2) - (alignHeight / 2)
    local weld = Instance.new("Weld")
    weld.Part0 = upper
    weld.Part1 = leg
    weld.C0 = CFrame.new(R15_OFFSET + Vector3.new(0, y, 0))
    weld.Parent = leg

    -- Keep the original leg hidden even if the game tries to reset it
    local function enforce()
        if upper.Transparency ~= 1 then upper.Transparency = 1 end
        if lower.Transparency ~= 1 then lower.Transparency = 1 end
        if foot.Transparency ~= 1 then foot.Transparency = 1 end
    end
    enforce()

    local conns = {
        upper:GetPropertyChangedSignal("Transparency"):Connect(enforce),
        lower:GetPropertyChangedSignal("Transparency"):Connect(enforce),
        foot:GetPropertyChangedSignal("Transparency"):Connect(enforce),
    }

    return function()
        for _, c in ipairs(conns) do
            c:Disconnect()
        end
        leg:Destroy()
        upper.Transparency = old.upper
        lower.Transparency = old.lower
        foot.Transparency = old.foot
    end
end

local function applyKorbloxR6(char)
    local leg = char:WaitForChild("Right Leg", 5)
    if not leg then
        warn("[LocalCosmetics] R6 Right Leg missing in " .. char:GetFullName())
        return nil
    end

    for _, child in ipairs(leg:GetChildren()) do
        if child:IsA("SpecialMesh") then
            child:Destroy()
        end
    end

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.FileMesh
    mesh.MeshId = KORBLOX_MESH
    mesh.TextureId = KORBLOX_TEXTURE
    mesh.Scale = Vector3.new(1, 1, 1)
    mesh.Offset = R6_OFFSET
    mesh.Parent = leg

    return function()
        mesh:Destroy()
    end
end

-- Headless

local function applyHeadlessTo(char)
    local head = char:WaitForChild("Head", 5)
    if not head then
        warn("[LocalCosmetics] Head not found in " .. char:GetFullName())
        return nil
    end

    local oldHead = head.Transparency
    local face = head:FindFirstChildOfClass("Decal")
    local oldFace = face and face.Transparency

    -- Keep the head hidden even if the game tries to reset it
    local function enforce()
        if head.Transparency ~= 1 then head.Transparency = 1 end
        if face and face.Transparency ~= 1 then face.Transparency = 1 end
    end
    enforce()

    local conns = { head:GetPropertyChangedSignal("Transparency"):Connect(enforce) }
    if face then
        table.insert(conns, face:GetPropertyChangedSignal("Transparency"):Connect(enforce))
    end

    return function()
        for _, c in ipairs(conns) do
            c:Disconnect()
        end
        head.Transparency = oldHead
        if face and oldFace then
            face.Transparency = oldFace
        end
    end
end

-- Effect helpers (apply / remove on the current character)

local function removeKorblox()
    if korbloxRevert then
        pcall(korbloxRevert)
        korbloxRevert = nil
    end
end

local function removeHeadless()
    if headlessRevert then
        pcall(headlessRevert)
        headlessRevert = nil
    end
end

local function applyKorblox(char)
    removeKorblox()
    if not char then return end

    -- Detect the rig by its parts, so this works without a Humanoid
    if char:FindFirstChild("RightUpperLeg") then
        korbloxRevert = applyKorbloxR15(char)
    elseif char:FindFirstChild("Right Leg") then
        korbloxRevert = applyKorbloxR6(char)
    else
        warn("[LocalCosmetics] No leg found in " .. char:GetFullName())
    end
end

local function applyHeadless(char)
    removeHeadless()
    if not char then return end
    headlessRevert = applyHeadlessTo(char)
end

-- Accessories by ID (templates are cached, clones are attached per character)

local function loadAccessories(id)
    local ok, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. id)
    end)
    if not ok or not result or #result == 0 then
        return nil, "Could not load asset " .. id
    end

    local found = {}
    for _, obj in ipairs(result) do
        if obj:IsA("Accessory") then
            table.insert(found, obj)
        else
            for _, d in ipairs(obj:GetDescendants()) do
                if d:IsA("Accessory") then
                    table.insert(found, d)
                end
            end
        end
    end

    if #found == 0 then
        return nil, "No accessory found in " .. id
    end
    return found
end

local function weldAccessory(char, acc)
    local handle = acc:FindFirstChild("Handle")
    if not handle then return false end

    handle.Anchored = false
    handle.CanCollide = false

    -- Modern accessories: match the handle's attachment to one on the character
    local handleAtt = handle:FindFirstChildOfClass("Attachment")
    if handleAtt then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local target = part:FindFirstChild(handleAtt.Name)
                if target and target:IsA("Attachment") then
                    local weld = Instance.new("Weld")
                    weld.Part0 = part
                    weld.Part1 = handle
                    weld.C0 = target.CFrame
                    weld.C1 = handleAtt.CFrame
                    weld.Parent = handle
                    return true
                end
            end
        end
    end

    -- Classic hats: no attachment, so use the old hat offset on the head
    local head = char:FindFirstChild("Head")
    if head then
        local weld = Instance.new("Weld")
        weld.Part0 = head
        weld.Part1 = handle
        weld.C0 = CFrame.new(0, 0.5, 0)
        weld.C1 = acc.AttachmentPoint
        weld.Parent = handle
        return true
    end

    return false
end

-- Attach clones of an entry's accessories to the given character
local function equipEntry(entry, char, hum)
    -- remove clones from a previous character/equip
    for _, acc in ipairs(entry.live) do
        pcall(function() acc:Destroy() end)
    end
    table.clear(entry.live)

    for _, template in ipairs(entry.templates) do
        local acc = template:Clone()
        acc.Parent = nil

        -- Try the normal route first. AddAccessory can fail without throwing
        -- (e.g. "Humanoid is not a valid character"), so check the parent afterwards.
        if hum then
            pcall(function() hum:AddAccessory(acc) end)
        end
        if acc.Parent ~= char then
            acc.Parent = char
        end

        -- If the normal attach didn't create a weld, do it by hand
        local handle = acc:FindFirstChild("Handle")
        if handle
            and not handle:FindFirstChildWhichIsA("Weld")
            and not handle:FindFirstChildWhichIsA("WeldConstraint") then
            weldAccessory(char, acc)
        end

        table.insert(entry.live, acc)
    end
end

local function removeEntry(entry)
    if entry.removed then return end
    entry.removed = true

    for _, acc in ipairs(entry.live) do
        pcall(function() acc:Destroy() end)
    end
    for _, t in ipairs(entry.templates) do
        pcall(function() t:Destroy() end)
    end
    if entry.row then
        entry.row:Destroy()
    end

    local i = table.find(entries, entry)
    if i then
        table.remove(entries, i)
    end
end

local function removeAllAccessories()
    for i = #entries, 1, -1 do
        removeEntry(entries[i])
    end
end

