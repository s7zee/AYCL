-- Keybinds (ignored while typing in a TextBox)

table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if KEYBINDS.ToggleMinimize and input.KeyCode == KEYBINDS.ToggleMinimize then
        setMinimized(not minimized)
    elseif KEYBINDS.Close and input.KeyCode == KEYBINDS.Close then
        closeScript()
    end
end))

-- Rig setup: runs on the visual rig now and every time it is recreated

local currentChar = nil

local function setup(char)
    currentChar = char

    char:WaitForChild("Head", 5)
    task.wait(0.5)
    if closed or currentChar ~= char then return end

    -- The old rig's parts are gone, so just forget the old undo functions
    korbloxRevert = nil
    headlessRevert = nil

    if korbloxOn then
        applyKorblox(char)
    end
    if headlessOn then
        applyHeadless(char)
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    for _, entry in ipairs(entries) do
        equipEntry(entry, char, hum)
    end
end

-- Lets the next run of this script replace this one cleanly
env.LocalCosmeticsCleanup = closeScript

buildGui()

task.spawn(function()
    local rigs = workspace:WaitForChild("Rigs", 5)

    if rigs then
        -- Evade-style setup: the visible avatar lives in Workspace.Rigs[PlayerName]
        table.insert(connections, rigs.ChildAdded:Connect(function(child)
            if child.Name == player.Name then
                task.spawn(setup, child)
            end
        end))
        local existing = rigs:FindFirstChild(player.Name)
        if existing then
            setup(existing)
        end
    else
        -- Normal games: use the regular character and reapply on respawn
        table.insert(connections, player.CharacterAdded:Connect(setup))
        if player.Character then
            setup(player.Character)
        end
    end
end)
