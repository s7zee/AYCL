local function getAnimator(char)
    if not char then return nil end

    local controller = char:FindFirstChildOfClass("Humanoid")
        or char:FindFirstChildOfClass("AnimationController")
    if not controller then
        controller = Instance.new("AnimationController")
        controller.Parent = char
    end

    local animator = controller:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = controller
    end
    return animator
end

local function stopEmote()
    if animTrack then
        pcall(function() animTrack:Stop() end)
        animTrack = nil
    end
end

local function playEmote(id)
    stopEmote()

    local animator = getAnimator(getVisualChar())
    if not animator then
        return false, "No rig found"
    end

    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. id

    local ok, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    if ok and track then
        animTrack = track
        animTrack.Looped = true
        animTrack:Play()
        return true
    end

    warn("[LocalCosmetics] Failed to load animation: " .. tostring(track))
    return false, "Could not load animation (wrong ID or private asset)"
end

-- Auto-stop: polls every frame, since Running/Jumping state changes
-- can fail to fire reliably in some games. Uses the real character's
-- Humanoid because that is what reacts to your input.
table.insert(connections, RunService.Heartbeat:Connect(function()
    if not animTrack then return end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local state = hum:GetState()
    if hum.MoveDirection.Magnitude > 0
        or state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.Swimming then
        stopEmote()
    end
end))

loadSavedEmotes()

-- Camera

local function getCamera()
    return workspace.CurrentCamera
end

-- One-time snap: puts the camera in front of the character
local function snapCamera()
    local camera = getCamera()
    local character = player.Character
    if not (camera and character) then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local charCFrame = hrp.CFrame
    local camPos = charCFrame.Position
        + charCFrame.LookVector * SNAP_DISTANCE
        + Vector3.new(0, HEIGHT_OFFSET, 0)
    local lookAt = charCFrame.Position + Vector3.new(0, HEIGHT_OFFSET, 0)

    camera.CameraType = Enum.CameraType.Scriptable
    camera.FieldOfView = FIELD_OF_VIEW
    camera.CFrame = CFrame.new(camPos, lookAt)

    camera.CameraType = Enum.CameraType.Custom
    camera.FieldOfView = FIELD_OF_VIEW

    player.CameraMinZoomDistance = SNAP_DISTANCE
    player.CameraMaxZoomDistance = SNAP_DISTANCE
    task.defer(function()
        player.CameraMinZoomDistance = 0.5
        player.CameraMaxZoomDistance = 400
    end)
end

-- Camlock: fixed position, only the look direction follows your head
local function enableCamLock()
    if camLocked then return end

    local camera = getCamera()
    local character = player.Character
    if not (camera and character) then return end
    if not character:FindFirstChild("Head") then return end

    camLocked = true

    -- Camera position is captured once and never changes while locked
    fixedCamPos = camera.CFrame.Position

    camera.CameraType = Enum.CameraType.Scriptable
    camera.FieldOfView = FIELD_OF_VIEW

    pcall(function() RunService:UnbindFromRenderStep("LocalCosmeticsCamLock") end)
    RunService:BindToRenderStep("LocalCosmeticsCamLock", Enum.RenderPriority.Camera.Value, function()
        local cam = getCamera()
        local char = player.Character
        local h = char and char:FindFirstChild("Head")
        if not (cam and h and fixedCamPos) then return end

        cam.CFrame = CFrame.new(fixedCamPos, h.Position)
    end)
end

local function disableCamLock()
    if not camLocked then return end
    camLocked = false
    pcall(function() RunService:UnbindFromRenderStep("LocalCosmeticsCamLock") end)
    fixedCamPos = nil

    local camera = getCamera()
    if camera then
        camera.CameraType = Enum.CameraType.Custom
        camera.FieldOfView = FIELD_OF_VIEW
    end

    player.CameraMinZoomDistance = 0.5
    player.CameraMaxZoomDistance = 400
end

local function syncCamSwitch()
    if camLockSwitchSet then
        camLockSwitchSet(camLocked)
    end
end

local function toggleCamLock()
    if camLocked then
        disableCamLock()
    else
        enableCamLock()
    end
    syncCamSwitch()
end

