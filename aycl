-- Best-effort asset id for the thumbnail of something the game equipped.
local function firstId(value)
    return value and tostring(value):match("%d+") or nil
end

local function originalThumbId(inst)
    if isClothing(inst) then
        return firstId(inst[CLOTHING_PROP[inst.ClassName]])
    end

    local handle = inst:FindFirstChild("Handle")
    if handle then
        if handle:IsA("MeshPart") and handle.MeshId ~= "" then
            return firstId(handle.MeshId)
        end
        local sm = handle:FindFirstChildOfClass("SpecialMesh")
        if sm and sm.MeshId ~= "" then
            return firstId(sm.MeshId)
        end
    end
    return nil
end

-- Finds what the rig was already wearing and lists it so it can be removed
local function scanOriginals(char)
    -- forget the previous scan (rows only; the instances belong to the game)
    for i = #entries, 1, -1 do
        if entries[i].kind == "original" then
            local e = table.remove(entries, i)
            e.removed = true
            if e.row then e.row:Destroy() end
        end
    end
    if not char then return 0 end

    local count = 0
    for _, child in ipairs(char:GetChildren()) do
        if not child:GetAttribute(CLONE_ATTR)
            and (child:IsA("Accessory") or isClothing(child)) then
            local entry = {
                kind = "original",
                name = child.Name,
                className = child.ClassName,
                templates = {},
                live = { child },
                thumbId = originalThumbId(child),
                removed = false,
            }
            table.insert(entries, entry)
            createRow(entry)
            count += 1
        end
    end
    return count
end

-- Keeps a clean copy of everything the rig wears, so "Reset avatar" can bring it back
local function captureOriginals(char)
    for _, b in ipairs(originalBackups) do
        pcall(function() b:Destroy() end)
    end
    table.clear(originalBackups)
    if not char then return end

    for _, child in ipairs(char:GetChildren()) do
        if not child:GetAttribute(CLONE_ATTR)
            and (child:IsA("Accessory") or isClothing(child)) then
            local ok, copy = pcall(function() return child:Clone() end)
            if ok and copy then
                table.insert(originalBackups, copy)
            end
        end
    end
end

-- Back to the original avatar: removes every added item, brings back original
-- items you removed with X, and refreshes the equipped list.
-- Returns success, number of original items restored.
local function resetAvatar()
    local char = getVisualChar()
    if not char then
        return false, 0
    end
    local hum = char:FindFirstChildOfClass("Humanoid")

    -- Also un-blanks any original clothing that added items replaced
    removeAllAdded()

    -- Count which originals are still on the rig
    local present = {}
    for _, child in ipairs(char:GetChildren()) do
        if not child:GetAttribute(CLONE_ATTR)
            and (child:IsA("Accessory") or isClothing(child)) then
            local key = child.ClassName .. "|" .. child.Name
            present[key] = (present[key] or 0) + 1
        end
    end

    -- Re-add the ones that are missing
    local restored = 0
    for _, backup in ipairs(originalBackups) do
        local key = backup.ClassName .. "|" .. backup.Name
        if (present[key] or 0) > 0 then
            present[key] -= 1
        else
            local copy = backup:Clone()
            attachToChar(copy, char, hum)
            restored += 1
        end
    end

    scanOriginals(char)
    return true, restored
end

local function addItemById(id)
    local char = getVisualChar()
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char then
        return false, "No rig found"
    end

    for _, e in ipairs(entries) do
        if e.kind == "catalog" and e.id == id then
            return false, id .. " is already equipped"
        end
    end

    local templates, err = loadItems(id)
    if not templates then
        return false, err
    end

    for _, t in ipairs(templates) do
        t.Parent = nil
    end

    -- Like a real avatar: a new shirt/pants/t-shirt replaces the previous added one
    local classes = {}
    for _, t in ipairs(templates) do
        if isClothing(t) then
            classes[t.ClassName] = true
        end
    end
    for i = #entries, 1, -1 do
        local e = entries[i]
        if e and e.kind == "catalog" then
            for _, t in ipairs(e.templates) do
                if classes[t.ClassName] then
                    removeEntry(e)
                    break
                end
            end
        end
    end

    -- Nice display name from the catalog, falling back to the object's name
    local name = templates[1].Name
    local okInfo, info = pcall(function()
        return MarketplaceService:GetProductInfo(tonumber(id))
    end)
    if okInfo and info and info.Name then
        name = info.Name
    end

    local entry = {
        kind = "catalog",
        id = id,
        name = name,
        className = templates[1].ClassName,
        templates = templates,
        live = {},
        hidden = {},
        thumbId = id,
        removed = false,
    }

    table.insert(entries, entry)
    equipEntry(entry, char, hum)
    createRow(entry)
    return true, "Added " .. id
end

