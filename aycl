-- Keybind saving / loading

local function saveKeybinds()
    pcall(function()
        if writefile then
            local data = {}
            for _, def in ipairs(KEYBIND_LIST) do
                local k = KEYBINDS[def.id]
                data[def.id] = k and k.Name or "None"
            end
            writefile(KEYBIND_FILE, HttpService:JSONEncode(data))
        end
    end)
end

local function loadKeybinds()
    local ok, result = pcall(function()
        if isfile and isfile(KEYBIND_FILE) then
            return HttpService:JSONDecode(readfile(KEYBIND_FILE))
        end
        return {}
    end)
    if not (ok and type(result) == "table") then return end

    for _, def in ipairs(KEYBIND_LIST) do
        local v = result[def.id]
        if v == "None" then
            if def.id ~= "ToggleMinimize" then
                KEYBINDS[def.id] = nil
            end
        elseif type(v) == "string" then
            local okKey, kc = pcall(function() return Enum.KeyCode[v] end)
            if okKey and kc then
                KEYBINDS[def.id] = kc
            end
        end
    end
end

local function resetKeybinds()
    for _, def in ipairs(KEYBIND_LIST) do
        KEYBINDS[def.id] = DEFAULT_KEYBINDS[def.id]
    end
    saveKeybinds()
end

loadKeybinds()

