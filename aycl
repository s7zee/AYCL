-- Keybinds

-- Called with the next key pressed while an action is waiting to be rebound
local function handleRebind(key)
    local id = rebindingId
    rebindingId = nil
    if not id then return end

    local msg
    if key == Enum.KeyCode.Escape then
        msg = "Cancelled"
    elseif key == Enum.KeyCode.Backspace then
        if id == "ToggleMinimize" then
            msg = "The window toggle needs a key, or you could not reopen the window"
        else
            KEYBINDS[id] = nil
            saveKeybinds()
            msg = KEYBIND_NAMES[id] .. " unbound"
        end
    elseif key == Enum.KeyCode.Unknown then
        msg = "That key is not supported"
    else
        local conflict
        for other, k in pairs(KEYBINDS) do
            if other ~= id and k == key then
                conflict = other
            end
        end
        if conflict then
            msg = key.Name .. " is already used by " .. KEYBIND_NAMES[conflict]
        else
            KEYBINDS[id] = key
            saveKeybinds()
            msg = KEYBIND_NAMES[id] .. " set to " .. key.Name
        end
    end

    if keybindStatusSet then keybindStatusSet(msg) end
    if refreshKeyHints then refreshKeyHints() end
end

-- Keybinds (ignored while typing in a TextBox)

table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    -- While rebinding, the next key press is captured instead of triggering anything
    if rebindingId then
        handleRebind(input.KeyCode)
        return
    end

    if processed then return end

    local key = input.KeyCode
    if KEYBINDS.ToggleMinimize and key == KEYBINDS.ToggleMinimize then
        setMinimized(not minimized)
    elseif KEYBINDS.Close and key == KEYBINDS.Close then
        closeScript()
    elseif KEYBINDS.CameraSnap and key == KEYBINDS.CameraSnap then
        snapCamera()
    elseif KEYBINDS.CameraLock and key == KEYBINDS.CameraLock then
        toggleCamLock()
    end
end))

-- Rig setup: runs on the visual rig now and every time it is recreated

local currentChar = nil

local function setup(char)
    currentChar = char

    char:WaitForChild("Head", 5)
    task.wait(0.5)
    if closed or currentChar ~= char then return end

    -- The old rig's parts are gone, so just forget the old undo functions
    korbloxRevert = nil
    headlessRevert = nil
    animTrack = nil

    -- Keep clean copies of the original items (for "Reset avatar"), then list them,
    -- BEFORE any catalog clones are added
    captureOriginals(char)
    scanOriginals(char)

    if korbloxOn then
        applyKorblox(char)
    end
    if headlessOn then
        applyHeadless(char)
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    for _, entry in ipairs(entries) do
        if entry.kind == "catalog" then
            equipEntry(entry, char, hum)
        end
    end
end

