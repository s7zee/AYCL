-- Replaces the currently added items with the outfit's items
local function applyOutfit(ids)
    removeAllAdded()
    local added, failed = 0, 0
    for _, id in ipairs(ids) do
        local ok = addItemById(tostring(id))
        if ok then
            added += 1
        else
            failed += 1
        end
    end
    return added, failed
end

