local function addAccessoryById(id)
    local char = getVisualChar()
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char then
        return false, "No rig found"
    end

    for _, e in ipairs(entries) do
        if e.id == id then
            return false, id .. " is already equipped"
        end
    end

    local templates, err = loadAccessories(id)
    if not templates then
        return false, err
    end

    for _, t in ipairs(templates) do
        t.Parent = nil
    end

    local entry = {
        id = id,
        name = templates[1].Name,
        templates = templates,
        live = {},
        removed = false,
    }

    table.insert(entries, entry)
    equipEntry(entry, char, hum)
    createRow(entry)
    return true, "Added " .. id
end

-- Window controls

local function setMinimized(state)
    minimized = state
    if mainFrame then
        mainFrame.Visible = not state
    end
end

-- Stops the script completely: removes effects, accessories, keybinds and GUI
local function closeScript()
    if closed then return end
    closed = true

    removeKorblox()
    removeHeadless()
    removeAllAccessories()

    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)

    if gui then
        gui:Destroy()
        gui = nil
    end
    mainFrame = nil
    listFrame = nil

    env.LocalCosmeticsCleanup = nil
end

