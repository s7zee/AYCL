        warn("[LocalCosmetics] No leg found in " .. char:GetFullName())
    end
end

local function applyHeadless(char)
    removeHeadless()
    if not char then return end
    headlessRevert = applyHeadlessTo(char)
end

-- Catalog items: accessories AND clothing (shirt / pants / t-shirt)
-- Templates are cached, clones are attached per character.

local function isClothing(inst)
    return CLOTHING_PROP[inst.ClassName] ~= nil
end

local function thumbUrl(id)
    return "rbxthumb://type=Asset&id=" .. tostring(id) .. "&w=150&h=150&filters=circular"
end

local function loadItems(id)
    local ok, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. id)
    end)
    if not ok or not result or #result == 0 then
        return nil, "Could not load asset " .. id
    end

    local found = {}
    for _, obj in ipairs(result) do
        if obj:IsA("Accessory") or isClothing(obj) then
            table.insert(found, obj)
        else
            for _, d in ipairs(obj:GetDescendants()) do
                if d:IsA("Accessory") or isClothing(d) then
                    table.insert(found, d)
                end
            end
        end
    end

    if #found == 0 then
        return nil, "No accessory or clothing found in " .. id
    end
    return found
end

local function weldAccessory(char, acc)
    local handle = acc:FindFirstChild("Handle")
    if not handle then return false end

    handle.Anchored = false
    handle.CanCollide = false

    -- Modern accessories: match the handle's attachment to one on the character
    local handleAtt = handle:FindFirstChildOfClass("Attachment")
    if handleAtt then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local target = part:FindFirstChild(handleAtt.Name)
                if target and target:IsA("Attachment") then
                    local weld = Instance.new("Weld")
                    weld.Part0 = part
                    weld.Part1 = handle
                    weld.C0 = target.CFrame
                    weld.C1 = handleAtt.CFrame
                    weld.Parent = handle
                    return true
                end
            end
        end
    end

    -- Classic hats: no attachment, so use the old hat offset on the head
    local head = char:FindFirstChild("Head")
    if head then
        local weld = Instance.new("Weld")
        weld.Part0 = head
        weld.Part1 = handle
        weld.C0 = CFrame.new(0, 0.5, 0)
        weld.C1 = acc.AttachmentPoint
        weld.Parent = handle
        return true
    end

    return false
end

-- Puts back the original clothing textures that an entry blanked out
local function restoreHidden(entry)
    if not entry.hidden then return end
    for _, h in ipairs(entry.hidden) do
        pcall(function() h.inst[h.prop] = h.value end)
    end
    entry.hidden = {}
end

-- Attach an accessory or clothing instance to a character (shared by equip and reset)
local function attachToChar(acc, char, hum)
    if isClothing(acc) then
        acc.Parent = char
        return
    end

    -- Try the normal route first. AddAccessory can fail without throwing
    -- (e.g. "Humanoid is not a valid character"), so check the parent afterwards.
    if hum then
        pcall(function() hum:AddAccessory(acc) end)
    end
    if acc.Parent ~= char then
        acc.Parent = char
    end

    -- If the normal attach didn't create a weld, do it by hand
    local handle = acc:FindFirstChild("Handle")
    if handle
        and not handle:FindFirstChildWhichIsA("Weld")
        and not handle:FindFirstChildWhichIsA("WeldConstraint") then
        weldAccessory(char, acc)
    end
end

-- Attach clones of an entry's items to the given character
local function equipEntry(entry, char, hum)
    -- remove clones from a previous character/equip
    for _, acc in ipairs(entry.live) do
        pcall(function() acc:Destroy() end)
    end
    table.clear(entry.live)
    restoreHidden(entry)
    entry.hidden = {}

    for _, template in ipairs(entry.templates) do
        local acc = template:Clone()
        acc.Parent = nil
        acc:SetAttribute(CLONE_ATTR, true)

        if isClothing(acc) then
            -- Only one of each clothing type renders, so blank the original ones
            local prop = CLOTHING_PROP[acc.ClassName]
            for _, other in ipairs(char:GetChildren()) do
                if other.ClassName == acc.ClassName and not other:GetAttribute(CLONE_ATTR) then
                    local old = other[prop]
                    if old ~= "" then
                        table.insert(entry.hidden, { inst = other, prop = prop, value = old })
                        other[prop] = ""
                    end
                end
            end
        end

        attachToChar(acc, char, hum)
        table.insert(entry.live, acc)
    end
end

local function removeEntry(entry)
    if entry.removed then return end
    entry.removed = true

    restoreHidden(entry)

    -- For original items, "live" holds the game's own instances, so this removes them locally
    for _, acc in ipairs(entry.live) do
        pcall(function() acc:Destroy() end)
    end
    for _, t in ipairs(entry.templates) do
        pcall(function() t:Destroy() end)
    end
    if entry.row then
        entry.row:Destroy()
    end

    local i = table.find(entries, entry)
    if i then
        table.remove(entries, i)
    end
end

-- Removes only items added through the catalog (original items are left alone)
local function removeAllAdded()
    for i = #entries, 1, -1 do
        local e = entries[i]
        if e and e.kind == "catalog" then
            removeEntry(e)
        end
    end
end

